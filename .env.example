# Copy to .env and fill in. NEVER commit .env or real values; .env is in .gitignore.
# Only the gateway reads Circle and wallet settings. The agent must never see them.

# ---- Ports (local dev) -------------------------------------------------------------------
GATEWAY_PORT=3001
PAID_API_PORT=3002
DASHBOARD_PORT=3003

# ---- Gateway ------------------------------------------------------------------------------
# Secret the agent presents to the gateway's /mcp endpoint. Generate one, e.g.:
#   openssl rand -hex 32
# Used by the gateway (to check) and the agent (to present). If empty, /mcp rejects everyone.
GATEWAY_SESSION_TOKEN=
# Where the agent finds the gateway. Defaults to http://localhost:$GATEWAY_PORT.
# GATEWAY_URL=http://localhost:3001
# SQLite file for the ledger and audit log.
GATEWAY_DB_PATH=provn.db
# Optional. Defaults to policies/policy.yaml in this repo.
# POLICY_PATH=
# "mock" never moves real money. "circle-dev" uses the Circle wallet below.
WALLET_ADAPTER=mock

# ---- Circle (gateway only) ----------------------------------------------------------------
# Developer-controlled wallets: https://developers.circle.com/wallets
CIRCLE_API_KEY=
# Secret that authorizes wallet operations. Keep it out of logs, chat, and git.
CIRCLE_ENTITY_SECRET=
# ID of the Circle wallet that pays on the user's behalf.
CIRCLE_WALLET_ID=

# ---- Agent --------------------------------------------------------------------------------
# "anthropic", "openai", or "stub" (no network calls).
LLM_PROVIDER=stub
LLM_API_KEY=

# ---- Arc testnet --------------------------------------------------------------------------
ARC_RPC_URL=https://rpc.testnet.arc.network
ARC_CHAIN_ID=5042002
# USDC ERC-20 interface on Arc (6 decimals). Native USDC uses 18; never use it for amounts.
USDC_ADDRESS=0x3600000000000000000000000000000000000000
# Filled in after deploying ProvnVault.
VAULT_ADDRESS=

# ---- Contract deployment and funding (contracts/script/Deploy.s.sol, scripts/fund-vault.sh) -
# Funded testnet account that deploys the vault and funds it. Testnet keys only.
DEPLOYER_PRIVATE_KEY=
# Address of Provn's spender (the Circle wallet address). Only this address can call spend().
SPENDER_ADDRESS=
# Vault limits in USDC base units (6 decimals): 5 USDC = 5000000.
PER_TX_MAX_USDC_BASE_UNITS=5000000
DAILY_BUDGET_USDC_BASE_UNITS=20000000
# Amount fund-vault.sh deposits, in whole USDC (e.g. 10 or 2.5).
FUND_AMOUNT_USDC=10

# ---- Paid API demo ------------------------------------------------------------------------
# Address the demo paid API names as its payee in 402 responses.
PAID_API_PAYEE=
# Second demo vendor. Allowlisted on the vault at deploy so the user's approval in demo step 6 can execute.
NEW_VENDOR_PAYEE=
